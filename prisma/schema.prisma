// Prisma schema — Nutri Luana Gois
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum KanbanStatus {
  NOVOS
  EM_AVALIACAO
  PLANO_ENTREGUE
  ACOMPANHAMENTO
}

enum MainGoal {
  EMAGRECIMENTO
  ESTETICA
  DESEMPENHO_ESPORTIVO
  REEDUCACAO_ALIMENTAR
  ENCAMINHADO_MEDICO
}

enum ConsultationFormStatus {
  PENDING
  SENT
  COMPLETED
}

enum ExamStatus {
  SOLICITADO
  RESULTADO_RECEBIDO
}

enum ExamResultFlag {
  NORMAL
  ATENCAO // fora da faixa de referência (alto ou baixo) — sinalizado para o operador revisar
  INDETERMINADO // faixa de referência complexa/qualitativa demais para determinar automaticamente
}

enum AppointmentType {
  CONSULTA
  RETORNO
}

enum AppointmentStatus {
  AGENDADO
  CONFIRMADO
  REALIZADO
  CANCELADO
}

// ---------------------------------------------------------------------------
// Identidade, sessão e auditoria (Fase 1 do plano mestre)
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN_MASTER // Luana — única conta profissional hoje; vê tudo
  NUTRICIONISTA // declarado e não usado — reservado para eventual virada multi-nutricionista (D2)
  PACIENTE // vê apenas os próprios dados, via dbForPatient
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(NUTRICIONISTA)
  active       Boolean  @default(true)

  // Dados profissionais — obrigatórios em todo registro de prontuário (Res. CFN 594/2017, Art. 8º)
  crn          String?
  crnRegion    String? // jurisdição, ex: "CRN-4" — ver <<DECISÃO BRUNO>> 9.4 do plano mestre
  profession   String? @default("Nutricionista")
  phone        String?
  signatureRef String? // referência do certificado/provedor de assinatura eletrônica (Fase 5)

  mustChangePassword Boolean   @default(true)
  mfaSecret          String? // TOTP — obrigatório para a conta profissional (ADMIN_MASTER)
  mfaEnabledAt       DateTime?
  lastLoginAt        DateTime?
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions       Session[]
  ownedClients   Client[]        @relation("NutritionistClients")
  patientProfile Client?         @relation("PatientUser")
  auditLogs      AuditLog[]
  passwordResets PasswordReset[]
}

model Session {
  id         String    @id @default(cuid())
  tokenHash  String    @unique // SHA-256 do token; o token puro só existe no cookie
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId])
  @@index([expiresAt])
}

/// Usado tanto para "esqueci minha senha" quanto para o link de primeiro acesso do
/// paciente convidado ao portal — funcionalmente é o mesmo fluxo (token de uso único → definir senha).
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum AuditAction {
  LOGIN
  LOGIN_FALHA
  LOGOUT
  VISUALIZAR_PRONTUARIO
  CRIAR
  ATUALIZAR
  EXCLUIR_LOGICO
  EXPORTAR
  ENVIAR_DOCUMENTO
  ALTERAR_REFERENCIA_EXAME
  CHAMADA_IA
  ACESSO_NEGADO
}

/// Append-only. Nunca UPDATE, nunca DELETE. Retenção mínima: 5 anos.
model AuditLog {
  id          String      @id @default(cuid())
  actorUserId String?
  actor       User?       @relation(fields: [actorUserId], references: [id])
  action      AuditAction
  entity      String? // "Client", "MealPlan", "ExamResult"...
  entityId    String?
  clientId    String? // qual prontuário foi tocado — permite responder ao titular (Art. 18)
  ip          String?
  userAgent   String?
  metadata    Json? // diff resumido, nunca o dado sensível inteiro
  createdAt   DateTime    @default(now())

  @@index([clientId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

/// Log de toda chamada a modelo de IA externo (D9) — trazido da Fase 11 para a Fase 7 porque
/// o importador de exames (5.7.3) já precisa gravar aqui. Nunca guarda o prompt nem dado de
/// paciente além do `clientId` (por id, não por nome).
model AiUsageLog {
  id           String   @id @default(cuid())
  purpose      String // "importar_exame", "importar_balanca", "enriquecer_receita", "anamnese"
  model        String // "gemini-flash-latest"
  clientId     String?
  userId       String?
  inputBytes   Int?
  outputTokens Int?
  success      Boolean
  errorText    String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Biblioteca de imagens (Fase 2B, construída retroativamente na Fase 10 — 5.11/3.8)
// ---------------------------------------------------------------------------

enum ImageSource {
  PIXABAY // buscada via API do Pixabay e baixada para o storage próprio
  UPLOAD_NUTRICIONISTA // foto enviada pela Luana
  CEDIDA_FABRICANTE // material oficial de marca (suplementos)
  GERADA_IA // imagem gerada por IA — precisa ser rotulada como tal
  OUTRA
}

/// Biblioteca única de imagens, compartilhada por alimentos, receitas, suplementos e produtos.
/// TODA imagem vive no bucket público-de-catálogo do projeto — nunca é servida por hotlink de
/// terceiro (5.11.3: a licença do Pixabay proíbe hotlink permanente).
model ImageAsset {
  id               String      @id @default(cuid())
  url              String // URL no storage próprio
  thumbUrl         String? // miniatura ~320px, usada em grade e no PDF
  source           ImageSource
  sourceRef        String? // id da imagem no Pixabay, ou nome do arquivo enviado
  sourcePageUrl    String? // página de origem (Pixabay), para auditoria
  author           String? // autor declarado na origem
  license          String? // "Pixabay Content License" | "Foto própria — Luana Gois" | ...
  altText          String? // acessibilidade e alt no PDF/portal
  searchTerm       String? // termo usado na busca — ajuda a reencontrar e a auditar
  width            Int?
  height           Int?
  bytes            Int?
  uploadedByUserId String?
  createdAt        DateTime    @default(now())

  foods              Food[]
  recipes            Recipe[]
  supplements        Supplement[]
  supplementProducts SupplementProduct[]
  mealOptions        MealOption[]

  @@index([source])
  @@index([searchTerm])
}

/// Cache de busca do Pixabay — exigência da própria licença (24h). Também reduz o consumo do
/// limite de 100 requisições/60s (5.11.3).
model PixabaySearchCache {
  id        String   @id @default(cuid())
  query     String   @unique
  payload   Json // resposta crua da API, já normalizada
  fetchedAt DateTime @default(now())

  @@index([fetchedAt])
}

model Client {
  id         String       @id @default(cuid())
  name       String
  email      String?
  phone      String?
  age        Int? // idade informada manualmente (fallback quando não há data de nascimento)
  birthDate  DateTime? // data de nascimento — usada para calcular idade automaticamente
  height     Float? // cm
  goal       String? // objetivo do cliente (ex: emagrecimento, hipertrofia)
  document   String? // identidade ou CPF
  profession String?
  notes      String?
  status     KanbanStatus @default(NOVOS)
  order      Int          @default(0) // posição dentro da coluna do kanban
  avatarSeed String?      @default(cuid())
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  // Consultório único: sempre a Luana. Era nullable (passo 1 de 3); backfill feito
  // em prisma/fase1-backfill-nutritionist.ts; agora obrigatória (passo 2 de 3).
  nutritionistId String
  nutritionist   User   @relation("NutritionistClients", fields: [nutritionistId], references: [id])

  userId String? @unique // conta do próprio paciente no portal (Fase 1/8)
  user   User?   @relation("PatientUser", fields: [userId], references: [id])

  // Menor de idade → acesso pelo responsável legal (Res. CFN 594/2017, Art. 3º, IV)
  guardianName     String?
  guardianDocument String?
  guardianEmail    String?
  guardianPhone    String?

  // Alertas clínicos — o construtor de plano bloqueia/avisa (Fase 4)
  allergies           String? // texto livre, exibido em faixa vermelha fixa
  intolerances        String?
  dietaryRestrictions String?
  foodAversions       String?

  // LGPD / prontuário (Res. CFN 594/2017, Art. 3º, VI — guarda de 20 anos, sem exclusão física)
  deletedAt     DateTime? // exclusão LÓGICA — nunca física dentro dos 20 anos
  deletedReason String?
  lastRecordAt  DateTime? // último registro clínico — base da contagem dos 20 anos

  measurements            Measurement[]
  dietLogs                DietLog[]
  mealPlans               MealPlan[]
  supplements             ClientSupplement[]
  supplementPrescriptions SupplementPrescription[]
  consultationForms       ConsultationForm[]
  consultations           Consultation[]
  exams                   Exam[]
  examResults             ExamResult[]
  examReferences          ClientExamReference[]
  appointments            Appointment[]

  @@index([nutritionistId])
}

// ---------------------------------------------------------------------------
// Histórico de consultas
// ---------------------------------------------------------------------------

model Consultation {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())

  mealPlans MealPlan[]

  @@index([clientId])
}

// ---------------------------------------------------------------------------
// Exames solicitados
// ---------------------------------------------------------------------------

model Exam {
  id            String     @id @default(cuid())
  clientId      String
  client        Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name          String
  requestedDate DateTime
  resultDate    DateTime?
  status        ExamStatus @default(SOLICITADO)
  notes         String?
  fileUrl       String? // resultado anexado (PDF/imagem)
  createdAt     DateTime   @default(now())

  @@index([clientId])
}

// ---------------------------------------------------------------------------
// Resultados de exames laboratoriais (importados via PDF + IA) — histórico
// acumulativo por parâmetro, com sinalização em relação ao valor de referência.
// ---------------------------------------------------------------------------

model ExamResult {
  id            String          @id @default(cuid())
  clientId      String
  client        Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  parameterName String // ex: "Ferritina Sérica", "Glicemia de Jejum" — texto literal extraído do laudo
  // Fase 7: FK para o catálogo curado — null quando a IA trouxe um nome que não bateu com
  // nenhum ExamParameter (fica pendente de catalogação, não é erro).
  parameterId   String?
  parameter     ExamParameter?  @relation(fields: [parameterId], references: [id])
  value         Float
  unit          String? // ex: "ng/mL", "mg/dL"
  collectedAt   DateTime // data da coleta desse resultado
  // A partir da Fase 7, referenceMin/referenceMax/referenceText passam a significar
  // EXCLUSIVAMENTE "o que o laboratório imprimiu neste laudo" — nunca mais sobrescritos por
  // faixa de catálogo ou de paciente (essas vivem em ExamParameter/ClientExamReference).
  referenceMin  Float? // limite inferior do V.R. impresso no laudo
  referenceMax  Float? // limite superior do V.R. impresso no laudo
  referenceText String? // texto original do V.R. impresso no exame (sempre preservado, prova documental)
  flag          ExamResultFlag  @default(INDETERMINADO) // legado: calculado só a partir da faixa do laudo
  // Fase 7: flag recalculado pela precedência de src/lib/examFlags.ts — o que a tela mostra.
  effectiveFlag ExamResultFlag?
  flagSource    String? // "faixa do paciente" | "catálogo" | "laudo" — de onde veio a faixa usada
  sourceFileUrl String? // PDF de onde este resultado foi extraído
  importBatchId String? // agrupa resultados vindos da mesma importação de PDF
  createdAt     DateTime        @default(now())

  @@unique([clientId, parameterName, collectedAt])
  @@index([clientId])
  @@index([parameterId])
}

// ---------------------------------------------------------------------------
// Catálogo de parâmetros de exame + faixa de referência por paciente (Fase 7)
// ---------------------------------------------------------------------------

/// Catálogo curado de parâmetros de exame. defaultMin/defaultMax ficam vazios de propósito —
/// faixa laboratorial varia por método/sexo/idade, e preenchê-las de memória seria inventar
/// (<<DECISÃO BRUNO>> 9.10). Entram por três vias: laudo importado, digitação da Luana aqui,
/// ou override por paciente em ClientExamReference.
model ExamParameter {
  id            String   @id @default(cuid())
  canonicalName String   @unique // "Ferritina", "Glicemia de jejum", "TSH"
  aliases       String? // sinônimos separados por "|" — usado no casamento da importação
  unit          String?
  category      String? // Hematologia, Bioquímica, Hormônios, Vitaminas...
  defaultMin    Float?
  defaultMax    Float?
  defaultText   String?
  higherIsWorse Boolean? // orienta a leitura visual do gráfico
  notes         String?

  results    ExamResult[]
  references ClientExamReference[]
}

/// Faixa de referência personalizada por paciente. A faixa impressa no laudo (ExamResult.reference*)
/// NUNCA é sobrescrita por este registro — ela é prova documental e continua acessível.
model ClientExamReference {
  id          String        @id @default(cuid())
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  parameterId String
  parameter   ExamParameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)
  refMin      Float?
  refMax      Float?
  refText     String?
  reason      String? // por que a nutricionista alterou — vira registro de prontuário
  setByUserId String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([clientId, parameterId])
  @@index([clientId])
}

// ---------------------------------------------------------------------------
// Agendamento de consultas e retornos futuros
// ---------------------------------------------------------------------------

model Appointment {
  id          String            @id @default(cuid())
  clientId    String
  client      Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  scheduledAt DateTime
  type        AppointmentType   @default(CONSULTA)
  status      AppointmentStatus @default(AGENDADO)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Fase 9 — janela mínima para o paciente pedir reagendamento pelo portal (5.9.1).
  cancellationDeadlineHours Int                            @default(24)
  rescheduleRequests        AppointmentRescheduleRequest[]

  @@index([clientId])
  @@index([scheduledAt])
}

enum RescheduleStatus {
  PENDENTE
  APROVADO
  RECUSADO
  CANCELADO_PELO_PACIENTE
}

/// Solicitação de reagendamento feita pelo paciente no portal (5.9.2). A regra das 24h
/// (Appointment.cancellationDeadlineHours) é validada no servidor, nunca só escondendo o botão.
model AppointmentRescheduleRequest {
  id                String           @id @default(cuid())
  appointmentId     String
  appointment       Appointment      @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  clientId          String
  requestedByUserId String
  proposedAt        DateTime // novo horário proposto
  alternativeAt     DateTime? // segunda opção
  reason            String?
  status            RescheduleStatus @default(PENDENTE)
  decidedByUserId   String?
  decidedAt         DateTime?
  decisionNote      String?
  createdAt         DateTime         @default(now())

  @@index([appointmentId])
  @@index([status, createdAt])
}

model Measurement {
  id       String   @id @default(cuid())
  clientId String
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date     DateTime @default(now())
  weight   Float // kg
  bodyFat  Float? // %
  waist    Float? // cm
  hip      Float? // cm

  // Bioimpedância (relatório de balança — ex: Bioeasy Pro)
  fatMassKg         Float? // massa gorda em kg
  subcutaneousFatKg Float? // massa de gordura subcutânea
  fatFreeMassKg     Float? // massa livre de gordura
  muscleMassPercent Float? // % massa muscular
  bodyWaterPercent  Float? // % água corporal
  bodyWaterKg       Float? // água corporal em kg
  bmi               Float? // IMC
  sarcopeniaIndex   Float?
  boneMassKg        Float?
  bmr               Int? // taxa metabólica basal (kcal)
  visceralFat       Int? // gordura visceral (nível)
  bioScore          Float? // pontuação geral do relatório
  segmental         Json? // massa muscular/gordura por segmento (tronco, braços, pernas)
  source            String? // ex: "Balança Bioeasy Pro 1" — indica origem não-manual da medição

  @@index([clientId])
}

model DietLog {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  weekStart DateTime // início da semana referente ao registro
  adherence Int // % de adesão à dieta (0-100)
  protein   Float? // g médios/dia
  carbs     Float? // g médios/dia
  fat       Float? // g médios/dia

  @@index([clientId])
}

// ---------------------------------------------------------------------------
// Banco de alimentos
// ---------------------------------------------------------------------------

enum NutrientSource {
  TACO // NEPA/Unicamp, 4ª ed. 2011
  IBGE_POF // Tabelas POF 2008-2009
  USDA // FoodData Central (CC0)
  ROTULO // rótulo do produto
  MANUAL // digitado pela nutricionista
  IMPORTADO_PENDENTE // veio de uma migração anterior, sem valor nutricional
}

enum NutrientStatus {
  VALIDADO // entra no somatório calórico
  PENDENTE // NÃO entra no somatório; interface sinaliza
}

enum FoodPreparation {
  NAO_APLICA
  CRU
  COZIDO
  ASSADO
  GRELHADO
  REFOGADO
  FRITO
  MEXIDO
  OMELETE
  PURE
  VAPOR
  DESIDRATADO
  EM_PO
}

model Food {
  id           String          @id @default(cuid())
  name         String // nome de exibição completo, ex: "Ovo de galinha, inteiro, cozido"
  baseName     String // nome canônico do alimento-base, ex: "Ovo de galinha, inteiro"
  preparation  FoodPreparation @default(NAO_APLICA)
  parentFoodId String? // agrupa preparos irmãos
  parentFood   Food?           @relation("FoodVariants", fields: [parentFoodId], references: [id])
  variants     Food[]          @relation("FoodVariants")

  brand        String? // DANONE, YOPRO, VERDE CAMPO...
  category     String? // Proteína, Carboidrato, Fruta, Laticínio, Gordura, Legume/Verdura, Leguminosa...
  defaultUnit  String      @default("g") // g, ml, unidade, fatia, colher de sopa...
  imageUrl     String? // legado — sombra até a Fase 11, use imageAsset a partir da Fase 10
  imageCredit  String? // legado — origem/licença da foto pré-biblioteca de imagens
  imageAssetId String?
  imageAsset   ImageAsset? @relation(fields: [imageAssetId], references: [id])
  aliases      String? // nomes regionais alternativos, separados por "|" (ex: "Mexerica|Tangerina")

  kcal100    Float? // kcal por 100g (ou por 100ml) — opcional, pode estar pendente
  protein100 Float?
  carbs100   Float?
  fat100     Float?
  fiber100   Float?
  sodium100  Float?

  source         NutrientSource @default(MANUAL)
  sourceRef      String? // código TACO, página do IBGE, URL do FoodData Central
  nutrientStatus NutrientStatus @default(PENDENTE)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  measures          FoodMeasure[]
  mealOptionItems   MealOptionItem[]
  recipeIngredients RecipeIngredient[]
  choiceGroupItems  ChoiceGroupItem[]

  @@unique([baseName, preparation, brand])
  @@index([parentFoodId])
  @@index([category])
}

/// Medida caseira com gramatura. Um alimento pode ter várias.
model FoodMeasure {
  id        String         @id @default(cuid())
  foodId    String
  food      Food           @relation(fields: [foodId], references: [id], onDelete: Cascade)
  label     String // "1 fatia", "1 concha média", "1 colher de sopa", "1 unidade", "1 dose"
  grams     Float // gramatura correspondente
  source    NutrientSource @default(MANUAL)
  sourceRef String?
  isDefault Boolean        @default(false)

  mealOptionItems MealOptionItem[]

  @@unique([foodId, label])
  @@index([foodId])
}

/// "PROTEÍNA: 180 GR (frango, patinho, tilápia...)" — grupo de opções equivalentes de um plano.
model ChoiceGroup {
  id              String  @id @default(cuid())
  name            String  @unique // "Proteína — almoço", "Carboidrato — escolher uma opção"
  displayLabel    String // rótulo literal impresso no PDF: "PROTEÍNA: 180 GR"
  defaultQuantity Float? // quantidade do cabeçalho do grupo
  defaultUnit     String?
  quantityText    String? // "A VONTADE", "ESCOLHER UMA OPÇÃO"
  notes           String? // "PRIORIZAR VEGETAIS VERDE ESCUROS"
  order           Int     @default(0)

  items           ChoiceGroupItem[]
  mealOptionItems MealOptionItem[]
}

model ChoiceGroupItem {
  id            String      @id @default(cuid())
  choiceGroupId String
  choiceGroup   ChoiceGroup @relation(fields: [choiceGroupId], references: [id], onDelete: Cascade)
  foodId        String?
  food          Food?       @relation(fields: [foodId], references: [id])
  description   String? // quando não há Food estruturado
  quantity      Float? // sobrepõe defaultQuantity do grupo
  unit          String?
  order         Int         @default(0)

  @@index([choiceGroupId])
  @@index([foodId])
}

// ---------------------------------------------------------------------------
// Receitas (biblioteca compartilhada)
// ---------------------------------------------------------------------------

model Recipe {
  id               String      @id @default(cuid())
  name             String
  description      String?
  ingredients      String // lista separada por linha (texto livre, sempre exibido)
  instructions     String?
  // Fase 10: cache MATERIALIZADO, recalculado do RecipeIngredient pelo motor da Fase 3 ao salvar —
  // deixaram de ser campo digitado. null = ingredientes não permitem cálculo ("macros pendentes"),
  // nunca herda o valor antigo sem revisão (esse fica em legacyMacrosNote, ver abaixo).
  calories         Int? // kcal
  protein          Float? // g
  carbs            Float? // g
  fat              Float? // g
  legacyMacrosNote String? // valor digitado antes da Fase 10, preservado só para comparação
  servings         Int? // nº de porções — motor de cálculo divide a soma dos ingredientes por isto (5.3.2 regra 7)
  prepTimeMin      Int? // tempo de preparo em minutos
  mealCategory     String? // desjejum/almoço/lanche/jantar/ceia/extra (5.10.1)
  isExtra          Boolean     @default(false) // aparece priorizada no bloco RECEITAS EXTRAS (5.10.1)
  imageUrl         String? // legado — sombra até a Fase 11, use imageAsset a partir da Fase 10
  imageAssetId     String?
  imageAsset       ImageAsset? @relation(fields: [imageAssetId], references: [id])
  tags             String? // separadas por vírgula (ex: "café da manhã,low carb")
  createdAt        DateTime    @default(now())

  ingredientItems RecipeIngredient[]
  mealOptionItems MealOptionItem[]
}

model RecipeIngredient {
  id          String  @id @default(cuid())
  recipeId    String
  recipe      Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  foodId      String?
  food        Food?   @relation(fields: [foodId], references: [id])
  description String? // usado quando não há Food estruturado (ex: "sal a gosto")
  quantity    Float?
  unit        String?
  order       Int     @default(0)

  @@index([recipeId])
  @@index([foodId])
}

// ---------------------------------------------------------------------------
// Plano alimentar do paciente
// ---------------------------------------------------------------------------

enum MealBlockType {
  AO_ACORDAR
  DESJEJUM
  COLACAO
  PRE_TREINO
  INTRA_TREINO
  POS_TREINO
  ALMOCO
  SOBREMESA
  LANCHE_TARDE
  JANTAR_LANCHE
  CEIA
  HIDRATACAO
  TAREFAS_INICIAIS
  RECEITAS_EXTRAS
  LIVRE
}

enum BlockSeparator {
  OU // opções alternativas — refeições
  LISTA // itens cumulativos — TAREFAS INICIAIS
}

enum MealPlanStatus {
  RASCUNHO
  FINALIZADO
  SUBSTITUIDO
}

enum PlanItemType {
  ALIMENTO
  RECEITA
  GRUPO_ESCOLHA
  TEXTO_LIVRE
  SUPLEMENTO
}

enum CalcStatus {
  CALCULADO // todos os itens com nutriente validado e quantidade numérica
  PARCIAL // algum item pendente ou não quantificável
  FAIXA // contém grupo de escolha — resultado é intervalo
  NAO_CALCULAVEL
}

model MealPlan {
  id                String   @id @default(cuid())
  clientId          String
  client            Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title             String   @default("Plano Alimentar")
  objective         String?
  generalGuidelines String? // itens separados por \n
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  consultationId          String? // consulta de referência — traz peso e data (5.4.5)
  consultation            Consultation?  @relation(fields: [consultationId], references: [id])
  version                 Int            @default(1)
  status                  MealPlanStatus @default(RASCUNHO)
  templateId              String? // se veio de um modelo
  initialGuidanceId       String? // FK → GuidanceText (orientação inicial)
  initialGuidance         GuidanceText?  @relation(fields: [initialGuidanceId], references: [id])
  initialGuidanceOverride String? // ajuste pontual do texto, sem alterar a biblioteca
  finalNotes              String?
  pdfUrl                  String?
  pdfNoPhotosUrl          String?
  signedAt                DateTime?
  signatureRef            String?
  // Totais materializados no momento do "Finalizar" — o PDF nunca recalcula depois.
  kcalTotalMin            Float?
  kcalTotalMax            Float?
  proteinTotalMin         Float?
  proteinTotalMax         Float?
  carbsTotalMin           Float?
  carbsTotalMax           Float?
  fatTotalMin             Float?
  fatTotalMax             Float?
  calcStatus              CalcStatus     @default(NAO_CALCULAVEL)
  calcWarnings            Json? // lista de itens excluídos do somatório e por quê

  meals      Meal[]
  deliveries PlanDelivery[]

  @@index([clientId])
  @@index([clientId, status])
}

model Meal {
  id         String   @id @default(cuid())
  mealPlanId String
  mealPlan   MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  name       String // "Desjejum", "Almoço", "Jantar"...
  order      Int      @default(0)

  blockType     MealBlockType  @default(LIVRE)
  displayTitle  String? // título literal, com condição embutida: "DESJEJUM SEGUNDA E QUINTA"
  suggestedTime String? // "07:00", "1 HR ANTES DO TREINO"
  separator     BlockSeparator @default(OU)
  daysOfWeek    Int[]          @default([]) // 1=seg ... 7=dom; vazio = todos os dias
  visible       Boolean        @default(true)
  kcalMin       Float?
  kcalMax       Float?
  calcStatus    CalcStatus     @default(NAO_CALCULAVEL)

  options MealOption[]

  @@index([mealPlanId])
}

model MealOption {
  id       String @id @default(cuid())
  mealId   String
  meal     Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)
  label    String @default("Opção 1")
  order    Int    @default(0)
  freeText String // texto legado — só é autoritativo quando isStructured = false (5.5.3)

  isStructured Boolean    @default(false)
  kcalMin      Float?
  kcalMax      Float?
  proteinMin   Float?
  proteinMax   Float?
  carbsMin     Float?
  carbsMax     Float?
  fatMin       Float?
  fatMax       Float?
  calcStatus   CalcStatus @default(NAO_CALCULAVEL)

  // Fase 10 (5.10.3) — foto opcional para uma opção que não é receita cadastrada (combinação
  // livre de alimentos, ex. "3 ovos mexidos + 2 fatias de pão"). Nunca sugerida automaticamente.
  imageAssetId String?
  imageAsset   ImageAsset? @relation(fields: [imageAssetId], references: [id])

  items MealOptionItem[]

  @@index([mealId])
}

model MealOptionItem {
  id            String       @id @default(cuid())
  mealOptionId  String
  mealOption    MealOption   @relation(fields: [mealOptionId], references: [id], onDelete: Cascade)
  foodId        String?
  food          Food?        @relation(fields: [foodId], references: [id])
  foodMeasureId String? // medida caseira escolhida (sobrepõe quantity/unit quando presente)
  foodMeasure   FoodMeasure? @relation(fields: [foodMeasureId], references: [id])
  recipeId      String?
  recipe        Recipe?      @relation(fields: [recipeId], references: [id])
  choiceGroupId String? // item referencia um grupo de escolha em vez de um alimento único
  choiceGroup   ChoiceGroup? @relation(fields: [choiceGroupId], references: [id])
  description   String? // fallback texto quando não há food/recipe/grupo estruturado
  quantity      Float?
  unit          String?
  order         Int          @default(0)

  itemType     PlanItemType @default(TEXTO_LIVRE)
  quantityMax  Float? // faixa: "160 A 180 GR" → quantity=160, quantityMax=180
  quantityText String? // literal não-quantificável: "A VONTADE", "PONTA DA FACA"
  literalText  String? // texto original do .docx, SEMPRE preservado
  showPhoto    Boolean      @default(false)
  kcal         Float? // materializado no "Finalizar" — o PDF nunca recalcula
  protein      Float?
  carbs        Float?
  fat          Float?
  calcStatus   CalcStatus   @default(NAO_CALCULAVEL)
  calcNote     String? // "alimento sem valor nutricional (pendente)"

  @@index([mealOptionId])
  @@index([foodId])
  @@index([foodMeasureId])
  @@index([recipeId])
  @@index([choiceGroupId])
}

/// Modelo de plano reutilizável entre pacientes ("Salvar como modelo").
model MealPlanTemplate {
  id              String   @id @default(cuid())
  name            String
  goal            String? // "Emagrecimento", "Hipertrofia", "Low carb"
  description     String?
  structure       Json // blocos → opções → itens, serializado (resolve foodId/recipeId/choiceGroupId por id)
  createdByUserId String?
  isShared        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum DeliveryChannel {
  SISTEMA
  WHATSAPP
  EMAIL
  IMPRESSO
}

/// Log de entrega — Res. CFN 731/2022 exige confirmação de recebimento do plano pelo paciente.
model PlanDelivery {
  id                       String                  @id @default(cuid())
  mealPlanId               String?
  mealPlan                 MealPlan?               @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  supplementPrescriptionId String?
  supplementPrescription   SupplementPrescription? @relation(fields: [supplementPrescriptionId], references: [id], onDelete: Cascade)
  clientId                 String
  channel                  DeliveryChannel
  sentByUserId             String?
  sentAt                   DateTime                @default(now())
  acknowledgedAt           DateTime? // confirmação de recebimento pelo paciente no portal
  notes                    String?

  @@index([clientId, sentAt])
}

// ---------------------------------------------------------------------------
// Suplementação (Fase 6) — três níveis: ativo → marca → produto, mais fórmula manipulada
// ---------------------------------------------------------------------------

enum SupplementOrigin {
  LOJA_SUPLEMENTOS
  MANIPULADO
  AMBOS
}

model Supplement {
  id            String           @id @default(cuid())
  activeName    String           @unique // "Magnésio bisglicinato", "Creatina monoidratada"
  category      String? // Proteína, Mineral, Vitamina, Pré-treino, Fibra, Bioativo...
  origin        SupplementOrigin @default(LOJA_SUPLEMENTOS)
  defaultDose   String? // "5 g", "3 cápsulas" — como a Luana escreve
  defaultTiming String? // "café da manhã", "30 min antes do treino"
  defaultRoute  String?          @default("Oral")
  ulNote        String? // limite superior tolerável, quando aplicável (Res. CFN 731/2022)
  notes         String?
  imageUrl      String? // legado — sombra até a Fase 11, use imageAsset a partir da Fase 10
  imageCredit   String?
  imageAssetId  String?
  imageAsset    ImageAsset?      @relation(fields: [imageAssetId], references: [id])
  active        Boolean          @default(true)
  createdAt     DateTime         @default(now())

  clientSupplements ClientSupplement[]
  products          SupplementProduct[]
  prescriptionItems SupplementPrescriptionItem[]
  formulaItems      CompoundedFormulaItem[]
}

model SupplementBrand {
  id      String  @id @default(cuid())
  name    String  @unique // TRUE SOURCE, VITAFOR, NUTRIFY, DUX, GROWTH, ESSENTIAL, EQUALIV, BODY ACTION
  website String?
  notes   String?

  products SupplementProduct[]
}

model SupplementProduct {
  id             String          @id @default(cuid())
  supplementId   String
  supplement     Supplement      @relation(fields: [supplementId], references: [id], onDelete: Cascade)
  brandId        String
  brand          SupplementBrand @relation(fields: [brandId], references: [id])
  commercialName String // "Creafort", "Magnesio Complex", "Energyzer Focus"
  presentation   String? // "pote 300 g", "60 cápsulas" — NULL quando não impresso
  flavors        String?
  doseLabel      String? // dose do rótulo
  nutritionJson  Json? // tabela nutricional do rótulo, quando existir
  anvisaRef      String? // registro/notificação — consultas.anvisa.gov.br
  imageUrl       String? // legado — sombra até a Fase 11, use imageAsset a partir da Fase 10
  imageCredit    String? // OBRIGATÓRIO quando imageUrl existe
  imageLicense   String? // "cedida pelo fabricante", "foto própria", "catálogo Essentia"
  imageAssetId   String?
  imageAsset     ImageAsset?     @relation(fields: [imageAssetId], references: [id])
  sourceRef      String? // "ESSENTIA GROUP.pdf, p. 12"
  active         Boolean         @default(true)

  @@unique([brandId, commercialName])
  @@index([supplementId])
}

model CompoundedFormula {
  id              String   @id @default(cuid())
  name            String // "Pré-treino manipulado (sachê saborizado)"
  presentation    String? // "40 doses em sachês saborizados"
  posology        String? // "Diluir uma dose em copo de água. Tomar 30 min antes do treino."
  route           String?  @default("Oral")
  notes           String?
  createdByUserId String?
  isShared        Boolean  @default(true)
  createdAt       DateTime @default(now())

  items             CompoundedFormulaItem[]
  prescriptionItems SupplementPrescriptionItem[]
}

model CompoundedFormulaItem {
  id           String            @id @default(cuid())
  formulaId    String
  formula      CompoundedFormula @relation(fields: [formulaId], references: [id], onDelete: Cascade)
  supplementId String?
  supplement   Supplement?       @relation(fields: [supplementId], references: [id])
  activeName   String // denormalizado
  quantity     String // "2 g", "150 mg" — texto, porque a unidade varia
  order        Int               @default(0)

  @@index([formulaId])
}

enum PrescriptionStatus {
  RASCUNHO
  FINALIZADA
  SUBSTITUIDA
}

/// Documento de prescrição. Campos obrigatórios conforme Res. CFN 656/2020 Art. 3º, XI
/// (com redação da Res. CFN 731/2022): nome do paciente, via, composição, posologia, data,
/// assinatura e carimbo com nº de inscrição e jurisdição no CRN, e contato.
model SupplementPrescription {
  id              String             @id @default(cuid())
  clientId        String
  client          Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  consultationId  String?
  date            DateTime           @default(now())
  // Autoria do documento — exigida em todo registro de prontuário (Res. CFN 594/2017, Art. 8º)
  createdByUserId String?
  version         Int                @default(1)
  status          PrescriptionStatus @default(RASCUNHO)
  generalNotes    String?
  pdfUrl          String?
  signedAt        DateTime?
  signatureRef    String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  items      SupplementPrescriptionItem[]
  deliveries PlanDelivery[]

  @@index([clientId, date])
}

model SupplementPrescriptionItem {
  id             String                 @id @default(cuid())
  prescriptionId String
  prescription   SupplementPrescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  section        SupplementOrigin       @default(LOJA_SUPLEMENTOS) // separa "PARA MANIPULAR" no PDF
  supplementId   String?
  supplement     Supplement?            @relation(fields: [supplementId], references: [id])
  formulaId      String?
  formula        CompoundedFormula?     @relation(fields: [formulaId], references: [id])
  displayName    String // denormalizado — o que sai no PDF
  acceptedBrands String? // "TRUE SOURCE, VITAFOR, NUTRIFY" — como a Luana escreve
  composition    String? // EXIGIDO pela Res. CFN 656/2020
  route          String                 @default("Oral") // EXIGIDO
  posology       String // EXIGIDO — "5 g diluído em água, no café da manhã, todos os dias"
  justification  String? // EXIGIDO no prontuário (Res. CFN 731/2022) — não vai no PDF do paciente
  active         Boolean                @default(true)
  discontinuedAt DateTime?
  order          Int                    @default(0)

  @@index([prescriptionId])
}

model ClientSupplement {
  id             String      @id @default(cuid())
  clientId       String
  client         Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  supplementId   String?
  supplement     Supplement? @relation(fields: [supplementId], references: [id])
  name           String // nome de exibição (denormalizado)
  instructions   String // dosagem/instrução completa
  active         Boolean     @default(true)
  discontinuedAt DateTime?
  order          Int         @default(0)
  createdAt      DateTime    @default(now())

  @@index([clientId])
}

// ---------------------------------------------------------------------------
// Formulário pré-consulta
// ---------------------------------------------------------------------------

model ConsultationForm {
  id          String                 @id @default(cuid())
  clientId    String
  client      Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  token       String                 @unique @default(cuid())
  status      ConsultationFormStatus @default(PENDING)
  sentAt      DateTime?
  completedAt DateTime?

  // respostas preenchidas pelo paciente
  fullName                  String?
  document                  String?
  profession                String?
  height                    Float?
  birthDate                 DateTime?
  mainGoal                  MainGoal?
  hasNutritionalFollowUp    Boolean?
  pathology                 String?
  doesPhysicalActivity      Boolean?
  physicalActivityFrequency String?
  medications               String?
  sleepQuality              String?
  gutHealth                 String?

  createdAt DateTime @default(now())

  @@index([clientId])
}

// ---------------------------------------------------------------------------
// Configurações — dados da nutricionista usados no rodapé/cabeçalho dos PDFs
// (linha única — sempre acessada/atualizada pelo id fixo "default")
// ---------------------------------------------------------------------------

model ProfessionalSettings {
  id               String   @id @default("default")
  nutritionistName String   @default("Luana Gois")
  crn              String   @default("09100683")
  logoUrl          String?
  address          String?
  phone            String?
  email            String?
  instagram        String?
  footerText       String?
  updatedAt        DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Biblioteca de Textos — frases e orientações reutilizáveis nos planos
// ---------------------------------------------------------------------------

enum GuidanceTextType {
  ORIENTACAO_GERAL
  HIDRATACAO
  SUPLEMENTACAO
  PRE_TREINO
  TAREFA_INICIAL
}

model GuidanceText {
  id        String           @id @default(cuid())
  title     String // rótulo curto para localizar
  content   String           @unique // texto completo, aceita quebras de linha — chave natural do seed
  type      GuidanceTextType @default(ORIENTACAO_GERAL)
  tags      String? // ex: "corrida curta,musculação"
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  mealPlansAsInitialGuidance MealPlan[]
}
